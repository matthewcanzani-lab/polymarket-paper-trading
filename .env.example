# Copy to .env and edit. .env is git-ignored.
# Nothing here is secret: this project never uses API keys, wallets or private keys.

# Minimum lifetime trading volume (USD) for a market to be used by the model.
# Pick this from `python -m pmodel volume-report`.
MIN_VOLUME_USD=0   # 0 = no cutoff yet; we pick the real value together after the volume report

# Only pull resolved markets that ended on/after this date.
HISTORY_START_DATE=2024-01-01

# Optional: folder for nightly prediction-log backups (e.g. iCloud Drive on a Mac):
# BACKUP_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/polymarket-model-v2-backups
